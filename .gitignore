# ROS 2 (colcon workspace)
# ---------------------------------------------------------------------------
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
log/

# ---------------------------------------------------------------------------
# Data, models and experiments
# Large files belong in DVC: commit the *.dvc / dvc.lock files, not the data.
# DVC also writes its own .gitignore entries next to tracked paths.
# ---------------------------------------------------------------------------
# DVC local cache/config (DVC normally ignores these itself, kept as a backstop)
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# ROS bags
*.mcap
*.db3
rosbag2_*/

# Model weights and exports
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# MLflow
mlruns/
mlartifacts/

# Hydra run outputs
outputs/
multirun/

